msgstr ""

#: inc/form.php:118
msgid "Helps staff match these hours to your record. Optional."
msgstr ""

#: inc/form.php:122
msgid "Date you volunteered"
msgstr ""

#: inc/form.php:134
msgid "How long you worked"
msgstr ""

#: inc/form.php:136
msgid "For example 3.5, 3:30, or 3h 30m. A plain number means hours, so for two hundred and ten minutes write 210m."
msgstr ""

#: inc/form.php:140
msgid "What you did"
msgstr ""

#: inc/form.php:153
