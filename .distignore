# Everything here is development-only and must not reach a release zip.
# `wp dist-archive .` reads this file.
.git
.gitignore
.github
.wordpress-org
.distignore
.wp-env.json
.wp-env.override.json
.wp-env.php74.json
.wp-env.php74.override.json
.wp-env.ci.json
.dev
.design
.phpunit.cache
.phpunit.result.cache
phpunit.xml.dist
phpunit.phar
phpunit-*.phar
tests

# Coding standards. All of it is development-only: the plugin has no runtime
# Composer dependencies and loads no autoloader, so vendor/ holds nothing but
# PHPCS and WPCS. It is listed because `wp dist-archive` reads the working
# directory rather than git, and an installed vendor/ would otherwise add
# several MB of linter to the zip.
composer.json
composer.lock
phpcs.xml.dist
.phpcs.cache
vendor

# The browser suite. Same arrangement as the linter above and for the same
# reason: Playwright is development tooling, installs no runtime dependency,
# and the plugin loads nothing from node_modules. The specs themselves live in
# tests/, which is already excluded — these three are the files that sit at the
# repository root, and `wp dist-archive` reads the working directory rather than
# git, so an installed node_modules would otherwise add a few hundred megabytes
# of browser harness to the zip.
package.json
package-lock.json
playwright.config.js
node_modules
README.md
.DS_Store

# The help system. Written for the coordinator and the director rather than for
# anybody reading the source, and excluded for the same reason README.md is:
# what a site owner installs is the plugin, and the documentation they can
# actually reach from it is readme.txt and the help tabs. A page sitting inside
# wp-content/plugins is one nobody opens. Host docs/help/ or publish it; do not
# ship it.
docs

# Working notes and tooling. These are tracked in git because they belong to the
# repository, and excluded here because they belong to nobody who installs the
# plugin. bin/ especially: the beta deploy script carries an SSH login, and this
# file is the only thing standing between it and a public zip on wordpress.org.
CLAUDE.md
.claude
bin
