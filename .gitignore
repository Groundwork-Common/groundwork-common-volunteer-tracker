# PHPUnit, fetched rather than committed — see the note in tests/bootstrap.php.
phpunit.phar
phpunit-*.phar
.phpunit.cache/
.phpunit.result.cache

# wp-env overrides: ports and the worktree mount. Written by bin/wpenv, which
# generates one per config file — wp-env derives an override's name from the
# --config it was given, so the 7.4 floor gets its own.
.wp-env.override.json
.wp-env.php74.override.json

# Written by the Tests workflow, one per PHP version in the matrix. Committed
# nowhere: the versions it is generated for live in .github/workflows/test.yml,
# and a stale copy on disk would quietly test the wrong one.
.wp-env.ci.json

# Local-only development scaffolding — mail routing, fixtures, throwaway
# mu-plugins. Mounted into wp-env by .wp-env.override.json. Nothing in here is
# loaded on a real site, and nothing in here should ever be relied on by code
# that ships. The recipe for recreating it is in README.md, so the knowledge is
# committed even though the files are not.
.dev/

node_modules/
vendor/
.DS_Store

# What a Playwright run leaves behind: the signed-in session and the fixture map
# global setup writes, the traces and screenshots kept from failures, and the
# HTML report. All of it is rebuilt by the next run, and the fixture map in
# particular is a file full of post IDs that mean nothing on anybody else's
# database.
tests/e2e/.state/
tests/e2e/.artifacts/
tests/e2e/.report/
